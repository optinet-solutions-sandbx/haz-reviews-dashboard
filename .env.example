# Client vars are inlined into the bundle at build time — treat them as public.
# src/lib/supabase.ts throws at module load if either of the first two is
# missing, so a misconfigured deploy fails immediately instead of returning
# confusing 401s from every query.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 'true' gates the whole app behind sign-in + admin approval.
# This project runs with it ON: nothing here is public.
VITE_REQUIRE_AUTH=true

# LOCAL ONLY — forces isAdmin and an account email so the admin-gated surfaces
# render with no Supabase project behind them. Ignored by any production build
# (src/lib/devOverrides.ts). Leave unset unless you are working on that UI.
# VITE_DEV_FORCE_ADMIN=true
# VITE_DEV_FORCE_EMAIL=you@example.com
# LOCAL ONLY — stand-in ranking snapshots so Home renders with real numbers
# before Supabase is wired up. Ignored by any production build.
# VITE_DEV_FORCE_FIXTURE=true

# ─── Ask AI ──────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Deliberately has NO VITE_ prefix: a VITE_ variable is inlined
# into the client bundle and readable in devtools, and this is an
# organisation-scoped credential. Read only by the dev-server middleware in
# vite/askAiProxy.ts, which never ships in a production build. Restart the dev
# server after changing either value — env is read once, at server start.
# OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-4o. The resolved name is shown in the Ask AI header,
# so a typo here is visible in the UI instead of surfacing as a provider 404.
# OPENAI_MODEL=gpt-4o
# Optional. For Azure OpenAI or an OpenAI-compatible proxy.
# OPENAI_BASE_URL=
