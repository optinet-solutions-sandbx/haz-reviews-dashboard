# Client vars are inlined into the bundle at build time — treat them as public.
# src/lib/supabase.ts throws at module load if either of the first two is
# missing, so a misconfigured deploy fails immediately instead of returning
# confusing 401s from every query.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 'true' gates the whole app behind sign-in + admin approval. A signed-out visitor
# is redirected to /login carrying where they were headed.
# This project runs with it ON: nothing here is public.
VITE_REQUIRE_AUTH=true



# LOCAL ONLY — forces isAdmin and an account email so the admin-gated surfaces
# render with no Supabase project behind them. Ignored by any production build
# (src/lib/devOverrides.ts). Leave unset unless you are working on that UI.
# VITE_DEV_FORCE_ADMIN=true
# VITE_DEV_FORCE_EMAIL=you@example.com
# LOCAL ONLY — stand-in ranking snapshots so Home renders with real numbers
# before Supabase is wired up. Ignored by any production build.
# VITE_DEV_FORCE_FIXTURE=true

# THE DEPLOYED DEMO. One flag: stand-in snapshots AND a forced admin AND the auth
# gate off, in a production build. Unlike the two above it is honoured outside DEV,
# which is exactly why it has its own name — a stray VITE_DEV_FORCE_* in a deployed
# environment must keep doing nothing. Leave unset for a real deployment.
# VITE_DEMO_MODE=true


# ─── Local tooling ───────────────────────────────────────────────────────────
# Read ONLY by scripts/verify-supabase.mjs, so `npm run verify:supabase` can run
# the account checks without arguments. Node parses this file directly.
#
# NO VITE_ PREFIX, ever. Vite inlines every VITE_* value into the client bundle,
# where a password is readable in devtools by anyone who loads the page — see
# invariant 40, which is about a credential reaching the CLIENT, not about this
# file. Nothing under src/ may read these. Do not add them to a deployment either;
# no deployed code reads them.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# ─── Ask AI ──────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Deliberately has NO VITE_ prefix: a VITE_ variable is inlined
# into the client bundle and readable in devtools, and this is an
# organisation-scoped credential. Read only by the dev-server middleware in
# vite/askAiProxy.ts, which never ships in a production build. Restart the dev
# server after changing either value — env is read once, at server start.
# OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-4o. The resolved name is shown in the Ask AI header,
# so a typo here is visible in the UI instead of surfacing as a provider 404.
# OPENAI_MODEL=gpt-4o
# Optional. For Azure OpenAI or an OpenAI-compatible proxy.
# OPENAI_BASE_URL=
# Set to exactly 'false' to disable the assistant endpoint's own authorization —
# the Supabase session check plus per-user rate limit in server/askAiAuth.ts.
# ONLY for local work with placeholder Supabase values, or a demo build where no
# session can exist.
#
# ABSENCE MEANS REQUIRED, which is the whole point: the app's sign-in gate is
# client-side (invariant 10 — RLS is the boundary) and RLS does not cover an
# OpenAI endpoint, so without a server-side check anyone who knows the URL can
# POST an arbitrary prompt and bill it to OPENAI_API_KEY. A forgotten variable
# must therefore lock the endpoint, never open it.
# ASK_AI_REQUIRE_AUTH=false

# ─── BPN ranks API ───────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Deliberately has NO VITE_ prefix: a VITE_ variable is inlined
# into the client bundle and readable in devtools (invariant 27), and this key
# reaches a third-party panel holding 135 domains belonging to other properties.
# Read in Node by vite/bpnRanksProxy.ts under `npm run dev`, and by the deployed
# function api/bpn-ranks.ts. Restart the dev server after changing it — env is read
# once, at server start.
#
# Without it the import modal's "Ranking API" tab reports itself unavailable and
# says why, which is the probe working as designed. The spreadsheet source is
# unaffected.
#
# The endpoint's authorization is the SAME gate the assistant uses, so
# ASK_AI_REQUIRE_AUTH above is the one switch for both. Absence means REQUIRED.
# SITES_API_KEY=bpn_...
